{
  "name": "koda-studio-site",
  "version": "1.0.0",
  "description": "Animated multi-page site for KODA indie game studio",
  "scripts": {
    "build:ts": "tsc",
    "build:scss": "sass --no-source-map src/styles:dist/styles",
    "build": "npm run build:ts && npm run build:scss",
    "watch:ts": "tsc --watch",
    "watch:scss": "sass --no-source-map --watch src/styles:dist/styles",
    "dev": "npm-run-all --parallel watch:ts watch:scss serve",
    "serve": "lite-server"
  },
  "devDependencies": {
    "lite-server": "^2.6.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.8",
    "typescript": "^5.4.0"
  }
}
